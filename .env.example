# Local mock paths (used when the corresponding *_HOST/_URL is unset):
# ACCOUNTS_PATH=data/sample/accounts.csv
# SESSIONS_PATH=data/sample/sessions.ndjson

# PostgreSQL accounts (production)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=accounts
POSTGRES_USER=etl
POSTGRES_PASSWORD=etl
POSTGRES_ACCOUNTS_TABLE=accounts

# Elasticsearch sessions (production)
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=sessions

# --- Warehouse (BigQuery in production; local mock uses DuckDB) -------------
# GOOGLE_CLOUD_PROJECT=
# BIGQUERY_DATASET=analytics

# --- Pipeline window (all UTC) ---------------------
# End date of the window (YYYY-MM-DD). Defaults to the sample-data end date.
# PIPELINE_END_DATE=2026-09-23
# Start date (YYYY-MM-DD). Defaults to 30 days before PIPELINE_END_DATE.
# PIPELINE_START_DATE=
# Extra days reprocessed before START_DATE to catch late-arriving events.
REPROCESS_WINDOW_DAYS=7

# --- Directories -------------------------------------------------------------
# RAW_DIR=data/raw
# PROCESSED_DIR=data/processed
# CCU_PATH=data/sample/detailed_ccu.csv

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
